# Variable names and safe defaults for the API (apps/api). Copy to .env (scripts/init.sh does it on first run).
# No secrets here: real keys and tokens are set in the environment, never committed.
API_HOST=127.0.0.1
# Comma-separated allowlist of message sources (^[a-z0-9-]{1,32}$ each); must not be empty.
ALLOWED_SOURCES=sim-1
# PROVISIONAL certainty threshold: 0 < tau <= 1 (ADR-014, ADR-015). Above 0.5 no complete case can be "sin alerta".
# Changing it needs clinical sign-off recorded in a PR.
CERTAINTY_TAU=0.5
# Optional overrides (defaults: knowledge/rules and knowledge/mappings):
# RULES_DIR=knowledge/rules
# MAPPINGS_DIR=knowledge/mappings
