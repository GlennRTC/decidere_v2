{
  "name": "decidere-mvp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "engine",
    "tests"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present && npm run typecheck",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "scan:phi": "python3 scripts/scan_phi.py $(git ls-files)"
  }
}
